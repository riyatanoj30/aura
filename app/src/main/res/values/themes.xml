<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme — dark luxury -->
    <style name="Theme.AURA" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>

    <!-- Launch screen theme (uses splash screen API) -->
    <style name="Theme.AURA.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_aura_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.AURA</item>
    </style>
</resources>
